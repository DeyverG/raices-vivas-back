# Plantilla de Variables de Entorno - Raíces Vivas Backend API REST

# Configuración del Servidor Express
PORT=5000
NODE_ENV=development

# Clave Secreta para Firma de Tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui

# ------------------------------------------------------------------------------
# OPCIÓN A: Conexión Local (PostgreSQL estándar / libpq)
# ------------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=raices_vivas_db
PGSSL=false

# ------------------------------------------------------------------------------
# OPCIÓN B: Conexión Vercel + Supabase (Producción / Remota)
# ------------------------------------------------------------------------------
# URL del Pooler de Supabase (Puerto 6543 - Recomendado para Vercel Serverless)
POSTGRES_URL="postgres://postgres.PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# URL Directa / Non-Pooling (Puerto 5432 - Recomendado para DBeaver)
POSTGRES_URL_NON_POOLING="postgres://postgres.PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Parámetros individuales de Supabase (Inyectados automáticamente por Vercel)
POSTGRES_HOST="aws-0-us-east-1.pooler.supabase.com"
POSTGRES_USER="postgres.PROJECT_REF"
POSTGRES_PASSWORD="TU_PASSWORD"
POSTGRES_DATABASE="postgres"

# Variables Supabase API Client (Inyectadas por la integración de Vercel)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key_aqui"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"
