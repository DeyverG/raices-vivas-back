# Plantilla de Variables de Entorno - Raíces Vivas Backend API
PORT=5000
NODE_ENV=development

# Configuración de Conexión a Base de Datos PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=tu_usuario_postgres
PGPASSWORD=tu_contraseña_postgres
PGDATABASE=raices_vivas_db

# Clave Secreta para Firma de Tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
